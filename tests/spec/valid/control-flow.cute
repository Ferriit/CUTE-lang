func loops(limit: i32): void {
    var total: i32 = 0;

    if (limit > 0) {
        total = total + 1;
    }
    else if (limit == 0) {
        total = 0;
    }
    else {
        total = -1;
    }

    for (var i: i32 = 0; i < limit; i++) {
        total += i;
    }

    for (var value: i32 -> range(0, limit)) {
        total += value;
    }

    while (total > 0) {
        total--;
    }

    run {
        print("running");
    }

    jump done;
    done:
}
